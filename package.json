{
  "name": "notes",
  "productName": "Notes",
  "version": "0.17.0",
  "description": "Keyboard-first markdown notes for Windows, with tabs and split panes",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "icon": "node scripts/generate-icon.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli:readme": "node scripts/cli-readme.mjs",
    "katex": "node scripts/katex-css.mjs",
    "postinstall": "node scripts/katex-css.mjs",
    "prestart": "node scripts/katex-css.mjs",
    "premake": "node scripts/katex-css.mjs",
    "pretest": "node scripts/katex-css.mjs"
  },
  "author": {
    "name": "Scarmonit",
    "email": "Scarmonit@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "43.3.0",
    "execa": "^10.0.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@bomb.sh/tab": "^0.0.22",
    "@inquirer/external-editor": "^3.0.5",
    "@inquirer/prompts": "^8.7.1",
    "commander": "^15.0.0",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.25",
    "marked": "^15.0.12",
    "mermaid": "^11.12.2"
  }
}
